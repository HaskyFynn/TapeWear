<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tw_primary"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Top app bar -->
    <include
        android:id="@+id/appbarInc"
        layout="@layout/include_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- DEMO image (hidden by default) -->
    <ImageView
        android:id="@+id/demoImageAuth"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/sample"
        android:visibility="gone" />

    <!-- Live camera preview -->
    <TextureView
        android:id="@+id/textureViewAuth"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ROI overlay -->
    <com.example.tapewear.ui.camera.OverlayView
        android:id="@+id/overlayViewAuth"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top instructions -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="84dp"
        android:paddingHorizontal="20dp"
        android:text="Select a pattern, align it in the box, then tap Authenticate"
        android:textColor="@color/tw_bg"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- ML / CV Pipeline Indicator -->
    <TextView
        android:id="@+id/modeIndicatorAuth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="16dp"
        android:textColor="@color/tw_bg"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="#44000000"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:rotation="-90" />

    <!-- Optional flash hint -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="112dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_flash_hint"
        android:text="Torch ON"
        android:textColor="#000000"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Latest ROI thumb (optional) -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:scaleType="centerCrop"
        android:background="#FFFFFFFF"
        android:elevation="2dp"
        android:padding="3dp"
        android:visibility="gone" />

    <!-- Bottom panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="20dp"
        android:paddingTop="12dp"
        android:background="#B300274C"
        android:gravity="center_horizontal"
        android:animateLayoutChanges="true">

        <TextView
            android:id="@+id/runtimeThresholdsAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="@color/tw_bg"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="match=0.80 | yolo=0.45" />

        <!-- Action row containing either Pattern Selector (Normal) OR Tag Autocomplete (Experiment) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <!-- NORMAL MODE: Pattern Spinner -->
            <LinearLayout
                android:id="@+id/normalPatternSelectorView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pattern:"
                    android:textColor="@color/tw_bg"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <Spinner
                        android:id="@+id/patternSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:popupBackground="@color/tw_bg"
                        android:paddingVertical="4dp" />
                    <TextView
                        android:id="@+id/slotStatusTextAuth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="2dp"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- EXPERIMENT MODE: Tag Autocomplete -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/experimentTagLayoutAuth"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select Pattern Tag"
                android:textColorHint="@color/tw_bg"
                app:hintTextColor="@color/tw_bg"
                app:boxStrokeColor="@color/tw_bg"
                android:visibility="gone">
                <AutoCompleteTextView
                    android:id="@+id/inputExperimentTagAuth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tw_bg"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </FrameLayout>

        <!-- Condition Controls (Only for Experiment Mode) -->
        <LinearLayout
            android:id="@+id/experimentConditionsGroupAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Illumination" android:textColor="@color/tw_bg" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleIlluminationAuth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">
                    <Button android:id="@+id/btnCondBrightAuth" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bright" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:strokeColor="@color/toggle_stroke_color" android:textColor="@color/toggle_text_color" app:backgroundTint="@color/toggle_bg_color"/>
                    <Button android:id="@+id/btnCondDimAuth" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dim" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:strokeColor="@color/toggle_stroke_color" android:textColor="@color/toggle_text_color" app:backgroundTint="@color/toggle_bg_color"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
            <View android:layout_width="16dp" android:layout_height="match_parent" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Distance" android:textColor="@color/tw_bg" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleDistanceAuth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">
                    <Button android:id="@+id/btnCondNearAuth" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Near" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:strokeColor="@color/toggle_stroke_color" android:textColor="@color/toggle_text_color" app:backgroundTint="@color/toggle_bg_color"/>
                    <Button android:id="@+id/btnCondFarAuth" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Far" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:strokeColor="@color/toggle_stroke_color" android:textColor="@color/toggle_text_color" app:backgroundTint="@color/toggle_bg_color"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </LinearLayout>

        <!-- Night mode toggle (Normal Mode Only) -->
        <LinearLayout
            android:id="@+id/normalNightModeGroupAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">
            <CheckBox
                android:id="@+id/flashCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="Night mode"
                android:textColor="@color/tw_bg"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
        
        <!-- Trial Counter (Experiment Mode Only) -->
        <TextView
            android:id="@+id/experimentTrialCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="4dp"
            android:text="Trial 1/3"
                    android:textColor="@color/tw_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Action slot: button OR progress -->
        <FrameLayout
            android:id="@+id/actionSlotAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnCaptureAuth"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Authenticate"
                android:textAllCaps="false"
                android:textSize="15sp"
                    app:backgroundTint="@color/tw_accent"
                    android:textColor="@color/tw_primary"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/progressLayoutAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <ProgressBar
                        android:id="@+id/progressBarAuth"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="0"
                        android:indeterminate="false"
                android:progressDrawable="@drawable/progress_accent" />

                    <!-- Experiment Mode Cancel Button -->
                    <Button
                        android:id="@+id/btnCancelAuth"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✕ Cancel"
                        android:textColor="#FF5252"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:minWidth="80dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/progressLineAuth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="Authenticating…"
                    android:textColor="@color/tw_bg"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Result card -->
        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_result_card"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:animateLayoutChanges="true">

            <TextView
                android:id="@+id/verdictText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verdict: —"
                android:textStyle="bold"
                android:textColor="@color/tw_bg"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/confidenceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confidence: —"
                android:textColor="@color/tw_bg"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/stagesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#BBBBBB"
                android:textSize="11sp" />
                
            <!-- Post-Auth Actions (Experiment Mode) -->
            <LinearLayout
                android:id="@+id/experimentAuthActionsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginTop="12dp">
                
                <Button
                    android:id="@+id/btnRetakeAuth"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Retake Trial"
                    app:strokeColor="@color/tw_bg"
                    android:textColor="@color/tw_bg" />
                    
                <View android:layout_width="12dp" android:layout_height="match_parent" />
                
                <Button
                    android:id="@+id/btnNextTrialAuth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Next Trial"
                    app:backgroundTint="@color/tw_bg"
                android:textColor="@color/tw_primary" />
            </LinearLayout>
        </LinearLayout>
        
        <!-- Final Session Complete Screen (Experiment Mode Only) -->
        <LinearLayout
            android:id="@+id/sessionCompleteCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_result_card"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Session Complete"
                android:textColor="#4CAF50"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3/3 trials recorded successfully."
                android:textColor="@color/tw_bg"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnDoneAuth"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Next User (Return to Registration)"
                android:textAllCaps="false"
                app:backgroundTint="@color/tw_primary"
                android:textColor="@color/tw_bg" />
        </LinearLayout>

        <!-- Auth History -->
        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent Authentications"
                android:textColor="@color/tw_bg"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/historyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
