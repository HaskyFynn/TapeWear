<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:paddingTop="?attr/actionBarSize">



<include
        android:id="@+id/appbarInc"
        layout="@layout/include_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />



    <!-- Center content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="12dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:src="@drawable/ic_tapewear_logo"
            android:contentDescription="@string/tapewear_logo" />

        <!-- App name / motto -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tapewear"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:textColor="#000000"/>



        <TextView
            android:id="@+id/motto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/simple_and_secure"
            android:textSize="16sp"
            android:textColor="#444444"
            android:layout_marginTop="4dp"/>

        <!-- Buttons -->
        <LinearLayout
            android:id="@+id/btnRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/btnGoRegister"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_primary_btn"
                android:text="@string/register"
                android:textColor="@color/tw_bg" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnGoAuthenticate"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_dark_btn"
                android:text="@string/authenticate"
                android:textColor="@android:color/white"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="16dp"
        android:text="@string/copyrighttapewear"
        android:textColor="#757575"
        android:textSize="12sp" />
</FrameLayout>
