<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:paddingTop="?attr/actionBarSize">



<include
        android:id="@+id/appbarInc"
        layout="@layout/include_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />



    <!-- Center content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="12dp">

        <!-- Logo -->
        <ImageView
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:src="@drawable/ic_tapewear_logo"
            android:contentDescription="@string/tapewear_logo" />

        <!-- App name / motto -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tapewear"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:textColor="#000000"/>



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/simple_and_secure"
            android:textSize="16sp"
            android:textColor="#444444"
            android:layout_marginTop="4dp"/>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/btnGoRegister"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_primary_btn"
                android:text="@string/register"
                android:textColor="@color/tw_bg" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnGoAuthenticate"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_dark_btn"
                android:text="@string/authenticate"
                android:textColor="@android:color/white"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnGoSettings"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="⚙ Developer Settings"
            android:textColor="#888888" />

        <!-- Experiment Mode Indicator -->
        <LinearLayout
            android:id="@+id/experimentBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#1A237E"
            android:paddingVertical="10dp"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔬 Experiment Mode Active"
                android:textColor="#FFEB3B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/experimentConditionsSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Slots overview -->
        <TextView
            android:id="@+id/slotsStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="24dp"
            android:textColor="#555555"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center_horizontal" />
    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="16dp"
        android:text="@string/copyrighttapewear"
        android:textColor="#757575"
        android:textSize="12sp" />
</FrameLayout>
