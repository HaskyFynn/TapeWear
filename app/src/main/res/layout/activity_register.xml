<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootRegister"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/umich_blue">

    <!-- Top app bar (optional; remove if you don't have it) -->
    <include
        android:id="@+id/appbarInc"
        layout="@layout/include_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- DEMO image (hidden by default) -->
    <ImageView
        android:id="@+id/demoImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/sample"
        android:visibility="gone" />

    <!-- Live camera preview -->
    <TextureView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay: draws maize ROI + status text -->
    <com.example.tapewear.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top instruction line -->
    <TextView
        android:id="@+id/topMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="84dp"
        android:paddingHorizontal="20dp"
        android:text="Day registration"
        android:textColor="@color/tw_bg"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Flash hint chip (shown in Night/torch situations) -->
    <TextView
        android:id="@+id/flashHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="112dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_flash_hint"
        android:text="Torch ON"
        android:textColor="#000000"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Latest full-frame/thumb preview (optional) -->
    <ImageView
        android:id="@+id/previewThumb"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:background="#FFFFFFFF"
        android:elevation="2dp"
        android:padding="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/previewLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="112dp"
        android:layout_marginEnd="12dp"
        android:textColor="@color/tw_bg"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Bottom controls -->
    <LinearLayout
        android:id="@+id/bottomPanelRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="28dp"
        android:gravity="center_horizontal"
        android:animateLayoutChanges="true">

        <!-- Row: Night mode + Data Collection toggles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <CheckBox
                android:id="@+id/flashCheckRegister"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:text="Night mode (Torch ON)"
                android:textColor="@color/tw_bg" />
        </LinearLayout>


        <!-- Action slot: Capture OR Progress -->
        <FrameLayout
            android:id="@+id/actionSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Capture"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:backgroundTint="@color/umich_blue"
                android:textColor="@color/tw_bg" />

            <LinearLayout
                android:id="@+id/progressSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:indeterminate="false" />

                <TextView
                    android:id="@+id/progressLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:text="Preparing…"
                    android:textColor="@color/tw_bg"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Export button -->
        <Button
            android:id="@+id/btnExport"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Export session (.zip)"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="@color/umich_blue"
            android:textColor="@color/tw_bg"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
