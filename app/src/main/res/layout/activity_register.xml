<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/umich_blue"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <include
        android:id="@+id/appbarInc"
        layout="@layout/include_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- DEMO image (hidden by default) -->
    <ImageView
        android:id="@+id/demoImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/sample"
        android:visibility="gone"
        android:contentDescription="@null" /> <!-- decorative -->

    <!-- Live camera preview -->
    <TextureView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay: draws maize ROI + status text -->
    <com.example.tapewear.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top instruction line -->
    <TextView
        android:id="@+id/topMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="84dp"
        android:paddingHorizontal="20dp"
        android:text="@string/register_day"
        android:textColor="@color/tw_bg"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- ML / CV Pipeline Indicator -->
    <TextView
        android:id="@+id/modeIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="16dp"
        android:textColor="@color/tw_bg"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="#44000000"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:rotation="-90" />

    <!-- Flash hint chip -->
    <TextView
        android:id="@+id/flashHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="112dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_flash_hint"
        android:text="@string/torch_on"
        android:textColor="#000000"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Latest thumb preview -->
    <ImageView
        android:id="@+id/previewThumb"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:background="#FFFFFFFF"
        android:elevation="2dp"
        android:padding="4dp"
        android:visibility="gone"
        android:contentDescription="@string/cd_preview_thumb" />

    <TextView
        android:id="@+id/previewLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="112dp"
        android:layout_marginEnd="12dp"
        android:textColor="@color/tw_bg"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Bottom controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="28dp"
        android:paddingTop="16dp"
        android:background="#B300274C"
        android:gravity="center_horizontal"
        android:animateLayoutChanges="true">

        <TextView
            android:id="@+id/runtimeThresholdsReg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="@color/tw_bg"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="match=0.80 | yolo=0.45" />

        <!-- Slot picker (moved inside bottom panel) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pattern_slot"
                android:textColor="@color/tw_bg"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <Spinner
                    android:id="@+id/spnSlot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingVertical="4dp"
                    tools:ignore="TouchTargetSizeCheck" />

                <TextView
                    android:id="@+id/slotStatusTextReg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Night mode toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <CheckBox
                android:id="@+id/flashCheckRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/night_mode_torch_on"
                android:textColor="@color/tw_bg"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Action slot: Capture OR Progress -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/capture"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:backgroundTint="@color/umich_maize"
                android:textColor="@color/umich_blue"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/progressSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/progress_maize" />

                <TextView
                    android:id="@+id/progressLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:text="@string/preparing"
                    android:textColor="@color/tw_bg"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Export button -->
        <Button
            android:id="@+id/btnExport"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="@string/export_zip"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="@color/umich_blue"
            android:textColor="@color/tw_bg"
            android:visibility="gone" />

        <TextView
            android:id="@+id/stagesTextReg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
