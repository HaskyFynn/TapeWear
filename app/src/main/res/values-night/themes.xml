<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.TapeWear" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Brand colors - keep the app palette consistent in dark mode -->
        <item name="colorPrimary">@color/tw_primary</item>
        <item name="colorOnPrimary">@color/tw_bg</item>
        <item name="colorSecondary">@color/tw_accent</item>
        <item name="colorOnSecondary">@color/tw_primary</item>

        <!-- Surfaces -->
        <item name="android:statusBarColor">@color/tw_primary</item>
        <item name="android:navigationBarColor">@color/tw_primary</item>
        <item name="colorSurface">@color/tw_text_primary</item>
        <item name="colorOnSurface">@color/tw_bg</item>

        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>

        <!-- Buttons default -->
        <item name="materialButtonStyle">@style/TW.Button</item>
        <item name="textAppearanceBodyLarge">@style/TW.BodyLarge</item>
        <item name="textAppearanceTitleLarge">@style/TW.TitleLarge</item>
    </style>
</resources>
