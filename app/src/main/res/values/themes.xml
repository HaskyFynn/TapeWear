<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TapeWear" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/tw_primary</item>
        <item name="colorOnPrimary">@color/tw_bg</item>
        <item name="colorSecondary">@color/tw_accent</item>
        <item name="colorOnSecondary">@color/tw_primary</item>

        <!-- Surfaces -->
        <item name="android:statusBarColor">@color/tw_primary</item>
        <item name="android:navigationBarColor">@color/tw_primary</item>
        <item name="colorSurface">@color/tw_bg</item>
        <item name="colorOnSurface">@color/tw_text_primary</item>

        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>


        <!-- Buttons default -->
        <item name="materialButtonStyle">@style/TW.Button</item>
        <item name="textAppearanceBodyLarge">@style/TW.BodyLarge</item>
        <item name="textAppearanceTitleLarge">@style/TW.TitleLarge</item>
    </style>

    <style name="TW.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/tw_primary</item>
        <item name="android:textColor">@color/tw_bg</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="TW.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/tw_text_primary</item>
    </style>

    <style name="TW.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tw_bg</item>
    </style>
</resources>
